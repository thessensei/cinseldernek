# --- SPEKTRUM çevre değişkenleri ---
# Port (opsiyonel, varsayılan 3000)
PORT=3000

# Google ile Giriş (OAuth 2.0) — https://console.cloud.google.com/apis/credentials
# 1) "OAuth Client ID" oluştur -> Web uygulaması
# 2) Yetkili yönlendirme URI'si ekle: http://localhost:3000/auth/google/callback
#    (canlıda: https://seninalanadin.com/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Oturum çerezi üretim ortamında HTTPS ister; yerelde otomatik kapanır.
# NODE_ENV=production
