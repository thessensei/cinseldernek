# SPEKTRUM ortam değişkenleri örneği.
# Kopyalayın:  cp .env.example .env
# Sunucu .env dosyasını kendiliğinden okumaz; şöyle çalıştırın:
#   node --env-file=.env server/index.js
# Gizli değerleri (parola vb.) asla commit etmeyin. .env dosyası .gitignore içindedir.

# --- Sunucu ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SQLite veritabanı dosyası (WAL modunda; yedeklerken -wal ve -shm dosyalarını da alın)
DB_PATH=data/app.db

# --- Oturum çerezleri -----------------------------------------------------
# HTTPS arkasında true yapın. NODE_ENV=production iken varsayılan true'dur.
COOKIE_SECURE=false
# lax | strict | none   (none seçilirse çerez otomatik olarak Secure olur)
COOKIE_SAMESITE=lax

# --- Ağ ------------------------------------------------------------------
# Ters vekil (nginx, Cloudflare vb.) arkasındaysanız vekil sayısını yazın (ör. 1).
# Vekil yoksa boş bırakın; aksi halde istemciler IP başlıklarını taklit edebilir.
TRUST_PROXY=
# API'ye farklı bir alan adından erişiliyorsa tam origin listesi (virgülle ayırın)
ALLOWED_ORIGINS=

# --- Demo verisi (yalnızca geliştirme) ------------------------------------
# 1 ise "npm run seed" demo hesapları ve örnek mesajları da ekler.
SEED_DEMO=0

# --- İlk yönetici hesabı (npm run create-admin için) ----------------------
# Komutu çalıştırdıktan sonra bu satırları silin ya da boş bırakın.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
