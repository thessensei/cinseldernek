# SPEKTRUM ortam ayarları
PORT=3000
# Üretimde NODE_ENV=production olarak ayarla.
# NODE_ENV=development

# SQLite dosyası (varsayılan: data/spektrum.db)
# DATABASE_PATH=/var/lib/spektrum/spektrum.db

# Google OAuth 2.0 (isteğe bağlı)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Uzman hesabı: üretimde bilinen demo hesabı oluşturulmaz.
# COUNSELOR_NAME=SPEKTRUM Uzman Ekibi
# COUNSELOR_EMAIL=uzman@ornek.org
# COUNSELOR_PASSWORD=uzun-ve-rastgele-bir-parola

# Demo girişi üretimde varsayılan olarak kapalıdır; yalnızca isteyerek aç.
# ENABLE_DEMO=true
